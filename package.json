{
  "name": "corelink",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Keycloak identity theme with CoreLink defaults",
  "repository": {"type":"git","url":"https://github.com/CoreLinkPlatform/Identity.git"},
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "build:keycloak": "npm run build && keycloakify build",
    "format": "prettier . --write",
    "check": "npm run typecheck && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "keycloakify": "^11.15.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.21"
  },
  "engines": {"node": ">=20"}
}
